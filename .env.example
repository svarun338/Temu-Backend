# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (the React dev server)
CLIENT_ORIGIN=http://localhost:5173
# Set to 1 when running behind a reverse proxy (so rate limiting sees real IPs)
TRUST_PROXY=0

# ---- Database (MySQL / MariaDB) ----
DB_HOST=124.1.1.1
DB_PORT=3306
DB_USER=root1
DB_PASSWORD=
DB_NAME=temu
# TLS to the database (e.g. a managed MySQL reached over the internet). Set REJECT_UNAUTHORIZED=false for self-signed certificates.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Optional: run migrations as a separate account (CREATE/ALTER), so DB_USER needs only SELECT/INSERT/UPDATE/DELETE.
DB_MIGRATION_USER=
DB_MIGRATION_PASSWORD=

# ---- Auth ----
# Must be at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# ---- One-time codes (email verification / password reset) ----
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
# Local development only: return the code in API responses and show it in the UI.
# Off unless set to true; always off in production and on hosting platforms (Railway, Render, Fly, Heroku).
OTP_DEV_DISPLAY=true

# ---- Email (optional in development) ----
# Leave SMTP_HOST empty to skip sending emails (use the development OTP display instead).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=TEMU <no-reply@temu.local>

# ---- Uploads ----
# Local folder (relative to temy_backend/) for upload temp files, and for all files when STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# Chat attachment size limits (MB)
MAX_IMAGE_MB=16
MAX_VIDEO_MB=100
MAX_AUDIO_MB=32
MAX_FILE_MB=100
# Total one user may upload per 24 hours (MB)
MAX_UPLOAD_MB_PER_DAY=2048

# ---- File storage (all files) ----
# Where EVERY file is stored: local (on this server, under UPLOAD_DIR) or s3 (the bucket below).
# Same paths in both, inside [S3_PREFIX] when using S3:
#   attachments/<ab>/<key>   chat photos, videos, voice notes, documents, stickers, GIFs, previews
#   avatars/<name>           profile and group photos
#   wallpapers/<name>        chat wallpapers
#   recordings/<yyyy>/<mm>/conversation-<id>/call-<id>/<recordingId>-<random>.webm
# Switching local -> s3: files already on the disk keep working; copy them over with
#   aws s3 sync uploads/ s3://<bucket>/<prefix> --exclude "tmp/*"
STORAGE_DRIVER=local  or s3
S3_BUCKET=
S3_REGION=ap-south-1
# Optional folder inside the bucket, e.g. prod/
S3_PREFIX=
# Only for S3-compatible services (MinIO, Cloudflare R2); leave empty for AWS
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# AWS credentials come from the EC2 instance role; locally you may set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.

# ---- Call recordings ----
# Largest recording (MB) and how long after a call ends an unfinished recording is saved (seconds)
MAX_RECORDING_MB=1024
RECORDING_FINALIZE_SECONDS=20
# Open tabs/devices per account
MAX_SOCKETS_PER_USER=20

# ---- Web Push (notifications when TEMU is closed) ----
# Generate with: npm run vapid   (leave empty to disable push; in-app notifications still work)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Voice / video calls (WebRTC) ----
# Seconds before an unanswered call counts as missed
CALL_RING_SECONDS=35
# A call survives its tab reconnecting for this long
CALL_RECONNECT_GRACE_SECONDS=20
# Group calls are a mesh (everyone sends to everyone): keep this small (6 is tested)
MAX_GROUP_CALL_PARTICIPANTS=6
# Free public STUN servers are used by default (comma-separated)
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Optional TURN relay (e.g. your own free coturn) for networks where a direct connection fails.
# Use TURN_SECRET with coturn's "use-auth-secret" (recommended), or a static username/credential.
TURN_URLS=
TURN_SECRET=
TURN_USERNAME=
TURN_CREDENTIAL=

# ---- GIF search (optional) ----
# Free key from https://developers.giphy.com (create an app, choose "API").
# Without it the GIF tab shows your recent GIFs, and .gif files can still be sent with 📎.
GIPHY_API_KEY=
# Content rating: g, pg, pg-13 or r
GIPHY_RATING=pg-13

# ---- End-to-end encryption ----
# The app always encrypts. With true, the server also refuses plaintext chat messages (from any API client).
E2EE_REQUIRED=false
# Browsers/devices per account (each has its own keys)
MAX_DEVICES_PER_USER=10
