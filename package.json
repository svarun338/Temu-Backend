{
  "name": "temu-server",
  "version": "1.0.0",
  "description": "TEMU real-time chat API: Express + Socket.IO + MySQL/MariaDB + JWT",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:create": "node src/db/cli.js create",
    "migrate": "node src/db/cli.js up",
    "migrate:down": "node src/db/cli.js down",
    "migrate:status": "node src/db/cli.js status",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "vapid": "node src/scripts/generateVapidKeys.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.0.16",
    "socket.io": "^4.8.4",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  }
}
